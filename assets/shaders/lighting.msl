#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct LightData
{
    float lightX;
    float lightY;
    float lightRadius;
    float aspectRatio;
};

struct main0_out
{
    float4 outColor [[color(0)]];
};

struct main0_in
{
    float2 inTexCoord [[user(locn1)]];
};

fragment main0_out main0(main0_in in [[stage_in]], constant LightData& ubo [[buffer(0)]], texture2d<float> occlusionMap [[texture(0)]], sampler occlusionMapSmplr [[sampler(0)]])
{
    main0_out out = {};
    float2 pos = in.inTexCoord;
    float2 lightPos = float2(ubo.lightX, ubo.lightY);
    float2 aspectVec = float2(ubo.aspectRatio, 1.0);
    float dist = length((lightPos - pos) * aspectVec);
    float attenuation = smoothstep(ubo.lightRadius, ubo.lightRadius * 0.0500000007450580596923828125, dist);
    if (dist > ubo.lightRadius)
    {
        out.outColor = float4(0.0, 0.0, 0.0, 0.64999997615814208984375);
        return out;
    }
    float targetIsWall = occlusionMap.sample(occlusionMapSmplr, pos).x;
    int steps = clamp(int(dist * 800.0), 30, 300);
    float2 dir = pos - lightPos;
    float2 stepVec = dir / float2(float(steps));
    float shadow = 1.0;
    for (int i = 0; i < steps; i++)
    {
        float2 samplePos = lightPos + (stepVec * float(i));
        float obstacle = occlusionMap.sample(occlusionMapSmplr, samplePos).x;
        if (obstacle > 0.5)
        {
            if (targetIsWall > 0.5)
            {
                shadow = 1.0;
            }
            else
            {
                shadow = 0.0;
            }
            break;
        }
    }
    float finalAlpha = 0.64999997615814208984375 - ((attenuation * shadow) * 0.64999997615814208984375);
    out.outColor = float4(0.0, 0.0, 0.0, fast::clamp(finalAlpha, 0.0, 0.64999997615814208984375));
    return out;
}

